# Usage:
#   git report            Cache hit -> print the cached report; miss -> run the gate
#                         (pre-commit), cache the result on success, and print it.
#   git report --record   Write a cache entry attesting that the gate passed, without
#                         running anything. Meant to be called from a pre-commit
#                         post-commit stage, right after a commit succeeds.
#   git report --capture [--] <cmd> [args...]
#                         Run <cmd>, pass its output through untouched, exit with its status,
#                         and leave a copy where --record can find it. Meant to prefix the
#                         gate's own pytest hook entry, so that a recorded entry carries the
#                         suite's numbers instead of only a colour. See README.md.
#
# A cache hit says so, on its first line, naming when the entry was produced and at which
# HEAD. Above the content, never below: a note under a wall of output is read after the
# reader has already believed the numbers were fresh.
#
# The cache key spans this repo and its declared dependencies (see below), not just
# this repo's HEAD: in a stack of editable-installed repos, a dependency's commit can
# change what this repo's tests do even though this repo's own HEAD hasn't moved. See
# README.md for the full design.
#
# Dependency file: a file named below at a repo's root, one relative repo path per
# line, blank lines and lines starting with '#' ignored. Absent file means no
# dependencies.

DEPS_FILE=".git-report-deps"

usage() {
    cat >&2 <<'EOF'
Usage:
  git report            Print a cached report; run the gate on a cache miss. A hit says it
                        is a hit, on the line above the content.
  git report --record   Attest that the gate passed for the current key; runs nothing.
  git report --capture [--] <cmd> [args...]
                        Run <cmd> transparently and leave its output for --record.
EOF
}

mode="report"
case "${1:-}" in
    "") ;;
    --record) mode="record" ;;
    --capture)
        mode="capture"; shift
        [ "${1:-}" = "--" ] && shift
        [ "$#" -gt 0 ] || { usage; exit 2; }
        ;;
    *) usage; exit 2 ;;
esac

self_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "git-report: not inside a git repository" >&2
    exit 1
}

cache_dir="$self_root/.git/info/git-report"

# Where --capture leaves a run for --record to pick up. A key is 64 hex characters, so the
# literal name cannot collide with one.
pending="$cache_dir/pending"

# A 'git mutate' sweep dirties the tree on purpose while a mutation is applied. Two places
# care: the dirty-tree refusal below says so instead of implying the repo is broken, and
# --capture writes nothing while it exists, because a mutated run's output is not a report of
# this tree.
sweep_lock="$(git -C "$self_root" rev-parse --absolute-git-dir)/git-mutate.lock"

# --capture is a wrapper around the gate's own test command, and its first duty is to be
# invisible: it must never refuse, never fail a commit, and never alter what the command
# printed or what it exited with. So every step of setting the capture up is allowed to fail,
# into a plain 'exec "$@"' that leaves nothing between the caller and the command at all.
#
# Only stdout is teed. Merging stderr into it would reorder a command's two streams and drag
# unrelated noise into the cache entry; a pytest summary is on stdout.
#
# 'tee', not a process substitution around an exec'd command: procsub leaves the copy being
# written by a process nobody waits for, so the command's output can surface *after* the
# wrapper has exited, and a caller that reads its log the moment the wrapper returns can read
# a truncated one. 'git mutate' is exactly such a caller. A foreground pipeline plus
# PIPESTATUS is ordered, complete on exit, and still exits with the command's own status.
#
# During a sweep it captures nothing and exec's, because a mutated run's output is not a
# report of this tree -- which also keeps the sweep's own path free of the pipeline, so
# 'git mutate --timeout' signals a process group holding nothing but the test command.
#
# The tree stamp is what makes the handshake exact. At pre-commit time the index is what will
# be committed (pre-commit stashes everything unstaged), so 'write-tree' is the tree the new
# commit will carry, and --record only uses a capture whose stamp matches the commit it is
# attesting. Without it, a commit that skipped the pytest hook -- 'types_or: [python]' skips
# it for a docs-only commit -- would inherit an earlier commit's numbers as if they were its
# own.
if [ "$mode" = "capture" ]; then
    if [ -d "$sweep_lock" ] ||
       ! tree=$(git -C "$self_root" write-tree 2>/dev/null) ||
       ! mkdir -p "$cache_dir" 2>/dev/null ||
       ! printf 'tree=%s\n' "$tree" > "$pending" 2>/dev/null; then
        exec "$@"
    fi
    "$@" | tee -a -- "$pending"
    exit "${PIPESTATUS[0]}"
fi

# Lists the repos that make up this key, in fixed order: declared dependencies (in
# the order they appear in the dependency file), then this repo itself, last.
list_repos() {
    local root="$1"
    local deps_file="$root/$DEPS_FILE"
    local line trimmed resolved

    if [ -f "$deps_file" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            trimmed=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            [ -z "$trimmed" ] && continue
            [ "${trimmed:0:1}" = "#" ] && continue
            resolved=$(cd "$root/$trimmed" 2>/dev/null && pwd) || {
                echo "git-report: dependency path '$trimmed' (from $deps_file) does not exist" >&2
                return 1
            }
            printf '%s\n' "$resolved"
        done < "$deps_file"
    fi
    printf '%s\n' "$root"
}

# key = sha256( HEAD_1 diffhash_1 ... HEAD_n diffhash_n  sha256(this script) )
# where diffhash_i = sha256( git diff HEAD ; git status --porcelain ; untracked contents )
# for repo i. A dirty dependency is hashed by its actual content, not a boolean, so two
# different work-in-progress states never share a key, and a clean tree collapses to
# the canonical sha256("") with no special-casing.
#
# The untracked contents are load-bearing, not thoroughness: 'git diff HEAD' covers tracked
# changes only and 'status --porcelain' prints an untracked file's *name* but never a byte of
# it, so without them editing an untracked module in a dependency left the key unchanged and
# replayed a report from before the edit. Measured, not theorised.
#
# --exclude-standard so an ignored file is still ignored, matching what status counts as
# dirtiness. This costs one read per untracked file in a dependency, and nothing for this
# repo: a dirty own tree, untracked files included, is refused before the key is computed.
compute_key() {
    local root="$1"
    local repos_file repo head diffhash acc

    repos_file=$(mktemp)
    if ! list_repos "$root" > "$repos_file"; then
        rm -f "$repos_file"
        return 1
    fi

    acc=""
    while IFS= read -r repo; do
        head=$(git -C "$repo" rev-parse HEAD 2>/dev/null) || {
            echo "git-report: '$repo' has no commits (or is not a git repo)" >&2
            rm -f "$repos_file"
            return 1
        }
        diffhash=$( {
            git -C "$repo" diff HEAD
            git -C "$repo" status --porcelain
            # NUL-delimited so an exotic filename cannot split a field. Sorted as well, which
            # no test can pin -- git already emits these in order -- so that a change in its
            # traversal order could not silently move the hash. A file that vanishes between
            # the listing and the hashing is skipped rather than fatal: the worst that can do
            # is miss the cache.
            git -C "$repo" ls-files --others --exclude-standard -z |
                sort -z |
                (cd "$repo" && xargs -0 -r sha256sum -- 2>/dev/null)
        } | sha256sum | cut -d' ' -f1)
        acc="$acc$head
$diffhash
"
    done < "$repos_file"
    rm -f "$repos_file"

    acc="$acc$(sha256sum "$(readlink -f "$0")" | cut -d' ' -f1)"
    printf '%s' "$acc" | sha256sum | cut -d' ' -f1
}

# A report certifies a clean, committed state. --record additionally relies on this:
# pre-commit validates the staged state and stashes the rest, so surviving unstaged
# changes mean the working tree is not what was validated.
if [ -n "$(git -C "$self_root" status --porcelain)" ]; then
    if [ "$mode" = "record" ]; then
        echo "git-report: '$self_root' has unstaged changes surviving the commit; pre-commit only validated the staged state. Refusing to record." >&2
    else
        echo "git-report: '$self_root' has a dirty working tree; a report must reflect a clean, committed state." >&2
    fi
    # Naming the sweep is the difference between "this repo is broken" and "a measurement is
    # in flight".
    if [ -d "$sweep_lock" ]; then
        sweep_pid=$(sed -n 's/^pid=//p' "$sweep_lock/info" 2>/dev/null)
        sweep_started=$(sed -n 's/^started=//p' "$sweep_lock/info" 2>/dev/null)
        echo "git-report: a 'git mutate' sweep is in flight (pid ${sweep_pid:-unknown}, since ${sweep_started:-unknown}); this dirtiness is transient. Wait for the sweep to finish." >&2
    fi
    exit 1
fi

key=$(compute_key "$self_root") || exit 1

entry="$cache_dir/$key"

# Every entry starts with a header line naming when it was produced and at which HEAD; the
# report itself is everything after it. That is what lets a hit say it is a hit instead of
# passing off an old run as a fresh one. Body on stdin.
#
# Written to a temp file in the cache directory and renamed, so a reader hitting the same
# key mid-write sees either no entry or a whole one, never a truncated report.
#
# No reader-side fallback for a missing header, because there cannot be one: the key hashes
# this script (see compute_key), so no entry written by a version without the header is ever
# looked up again. tests/test-git-report.sh test8 pins that.
CACHE_HEADER="git-report-cache"

write_entry() {
    local tmp_entry
    mkdir -p "$cache_dir" || return 1
    tmp_entry=$(mktemp "$cache_dir/.new.XXXXXX") || return 1
    {
        printf '%s at=%s head=%s\n' "$CACHE_HEADER" \
            "$(date -Is 2>/dev/null || date)" "$(git -C "$self_root" rev-parse HEAD)"
        cat
    } > "$tmp_entry" || { rm -f "$tmp_entry"; return 1; }
    mv "$tmp_entry" "$entry"
}

# --record runs as a post-commit hook, so it never sees its sibling hooks' output: it knows
# the gate passed and nothing else. That attestation is also the entry a worker meets most
# often -- clean tree at the recorded HEAD, straight into a cache hit -- so an entry with no
# content in it hands them a colour where a number was needed.
#
# So it folds in whatever --capture left for this commit's tree, and keeps the attestation
# line itself, which is the thing that stops a post-commit report from re-running the gate.
# When no capture matches, it says that plainly rather than leaving the reader to wonder
# whether the gate simply has nothing to say.
if [ "$mode" = "record" ]; then
    self_head=$(git -C "$self_root" rev-parse HEAD)
    {
        printf 'gate passed at %s, recorded at commit time\n' "$self_head"
        echo
        if [ "$(sed -n '1s/^tree=//p' "$pending" 2>/dev/null)" = "$(git -C "$self_root" rev-parse "HEAD^{tree}")" ]; then
            printf -- "--- the gate's own output for this tree, captured at pre-commit time ---\n"
            tail -n +2 "$pending"
        else
            printf 'this entry carries no gate output: no run was captured for this commit tree.\n'
            printf "Either this repo's test hook is not wired for capture (see README.md), or it\n"
            printf 'was skipped because the commit touched no files it selects. For a report with\n'
            printf 'numbers now:\n'
            printf "    rm '%s' && git report\n" "$entry"
        fi
    } | write_entry
    # Consumed either way: a capture that did not match this tree will not match a later one
    # either, and leaving it would offer the next commit an older commit's numbers.
    rm -f "$pending"
    exit 0
fi

if [ -f "$entry" ]; then
    # The notice goes to stdout, not stderr: it is part of the report, and its position
    # relative to the content is only meaningful -- and only pinnable -- in one stream.
    IFS=' ' read -r _marker at_field head_field < "$entry"
    printf 'git-report: btw, this report is cached -- produced at %s for HEAD %s, and replayed because nothing in the key has changed since. Nothing was re-run.\n' \
        "${at_field#at=}" "${head_field#head=}"
    tail -n +2 "$entry"
    exit 0
fi

if [ ! -f "$self_root/.pre-commit-config.yaml" ]; then
    echo "git-report: no .pre-commit-config.yaml in '$self_root'." >&2
    exit 1
fi
if ! command -v pre-commit >/dev/null 2>&1; then
    echo "git-report: 'pre-commit' not found on PATH." >&2
    exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
(cd "$self_root" && pre-commit run --all-files --hook-stage pre-commit) > "$tmp" 2>&1
status=$?

cat "$tmp"

if [ "$status" -eq 0 ]; then
    write_entry < "$tmp"
fi

exit "$status"
