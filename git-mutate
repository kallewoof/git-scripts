ANSI = re.compile(r"\x1b\[[0-9;]*m")

# Trap B: pytest *rewrites* assertions, so a genuine assertion failure usually carries no
# exception name at all ("assert [244, 331] == [244, 434]"), sometimes carries
# "AssertionError:", and carries "Failed:" for pytest.fail and for pytest.raises not raising.
BASE_ASSERTION = ("assert", "AssertionError", "Failed:")

# Trap B2: other ecosystems name their assertion failure something that is not "AssertionError"
# but still ends in "Error"/"Failure", so NAMED_EXC below would claim it and every genuine
# assertion kill in that language would be reported as an error kill.
ENV_ASSERTION = {
    "pytest": (),
    "mvn": (
        "AssertionFailedError",    # JUnit 5 / opentest4j -- what assertEquals and AssertJ throw
        "ComparisonFailure",       # JUnit 4
        "MultipleFailuresError",   # JUnit 5 assertAll
        "Expecting",               # AssertJ, when it reports without an exception name
    ),
    "go": ("Error Trace:", "Not equal:", "expected:"),
    "rust": ("assertion",),
    "dotnet": ("AssertionException", "EqualException", "Xunit.Sdk"),
}

NAMED_EXC = re.compile(r"^[A-Za-z_][A-Za-z0-9_.]*(Error|Exception|Exit|Warning|Interrupted)?:")

SUREFIRE_GLOBS = ("**/target/surefire-reports/TEST-*.xml",
                  "**/target/failsafe-reports/TEST-*.xml")

COMPILE_RE = re.compile(
    r"cannot find symbol|COMPILATION ERROR|Unresolved compilation|error: .*expected"
    r"|SyntaxError|cannot be resolved")


def strip_ansi(line):
    # Trap A: escape codes sit *inside* the test id, so stripping has to happen before the id
    # is extracted, not merely before the prefix is matched.
    return ANSI.sub("", line.rstrip("\n"))


def split_id(rest):
    # "FAILED <id> - <message>". A parametrized id can itself contain " - ", so prefer the
    # last "] - " when the id is parametrized; otherwise the first " - ".
    at = rest.rfind("] - ")
    if at != -1:
        return rest[:at + 1], rest[at + 4:]
    at = rest.find(" - ")
    if at != -1:
        return rest[:at], rest[at + 3:]
    return rest, ""


def classify_surefire():
    """Surefire/Failsafe print no FAILED/ERROR summary lines; the outcome lives only in XML."""
    ASSERTION_TYPES = ("AssertionError", "AssertionFailedError", "ComparisonFailure",
                       "MultipleFailuresError")
    rows = []
    paths = sorted(sum((glob.glob(g, recursive=True) for g in SUREFIRE_GLOBS), []))
    for path in paths:
        try:
            root = ET.parse(path).getroot()
        except (ET.ParseError, OSError):
            continue
        cls = root.get("name", "?").split(".")[-1]
        for case in root.iter("testcase"):
            node = case.find("failure")
            if node is None:
                node = case.find("error")
            if node is None:
                continue
            kind_name = (node.get("type") or "").split(".")[-1]
            msg = (node.get("message") or "").replace("\n", " ").replace("\t", " ").strip()
            kind = "A" if kind_name in ASSERTION_TYPES else "E"
            rows.append((kind, "%s::%s" % (cls, case.get("name", "?")),
                         "%s: %s" % (kind_name, msg)))
    return rows


def classify(log_path, env_name, extra_pattern):
    if env_name == "mvn":
        return classify_surefire()

    assertion = BASE_ASSERTION + ENV_ASSERTION.get(env_name, ())
    extra = re.compile(extra_pattern) if extra_pattern else None

    rows, seen = [], set()
    try:
        fh = open(log_path, "r", encoding="utf-8", errors="replace")
    except OSError:
        return rows
    with fh:
        for raw in fh:
            line = strip_ansi(raw)
            match = re.match(r"^(FAILED|ERROR)\s+(\S.*)$", line)
            if not match:
                continue
            head, rest = match.group(1), match.group(2)
            test_id, msg = split_id(rest)
            if test_id in seen:
                continue
            seen.add(test_id)
            if msg.startswith(assertion) or (extra and extra.search(msg)):
                kind = "A"
            elif head == "ERROR":
                # A collection or teardown error is an error kill whatever it says -- and an
                # import-time error produces these and no FAILED lines at all.
                kind = "E"
                if not msg:
                    msg = "collection error (pytest keeps the reason out of the summary line)"
            elif msg and NAMED_EXC.match(msg):
                kind = "E"
            else:
                kind = "U"
            rows.append((kind, test_id, msg))
    return rows


def count_tests(log_path, since, env_name):
    """Tests the last run actually executed, or -1 when this ecosystem gives us nothing to count.

    A green run that executed nothing is not "no test distinguishes the mutation" -- it is a
    command that measures nothing. `since` is a timestamp taken before the run: Surefire reports
    persist on disk, so a run that executes no tests leaves the *previous* run's XML in place,
    and counting those would report the earlier run's total and defeat the whole check.
    """
    if env_name == "mvn":
        total, saw_fresh_report = 0, False
        for path in sorted(sum((glob.glob(g, recursive=True) for g in SUREFIRE_GLOBS), [])):
            try:
                if os.path.getmtime(path) < since:
                    continue
                root = ET.parse(path).getroot()
            except (OSError, ET.ParseError):
                continue
            saw_fresh_report = True
            total += int(root.get("tests") or 0)
        return total if saw_fresh_report else 0

    try:
        text = open(log_path, errors="replace").read()
    except OSError:
        return -1

    if env_name == "pytest":
        if re.search(r"\bno tests ran\b", text):
            return 0
        collected = re.findall(r"\bcollected (\d+) items?", text)
        if collected:
            return max(int(x) for x in collected)
        total, found = 0, False
        for word in ("passed", "failed", "errors", "error", "skipped", "xfailed", "xpassed"):
            for value in re.findall(r"(\d+) %s\b" % word, text):
                total += int(value)
                found = True
        return total if found else -1

    return -1


def fast_probe(cmd):
    """Can test ids simply be appended to this command? Returns None, or the reason they cannot.

    Appending is only a narrowing when the command names no path of its own: `pytest tests/ <id>`
    runs all of tests/ AND the id, which is slower than the full run it was meant to replace.
    Anything this cannot read for certain is refused -- guessing costs the user time on every
    mutation, silently.
    """
    try:
        toks = shlex.split(cmd)
    except ValueError as exc:
        return "the test command cannot be tokenised (%s)" % exc

    idx = None
    for i, t in enumerate(toks):
        if t == "pytest" or t.endswith("/pytest"):
            idx = i
            break
        if t == "-m" and i + 1 < len(toks) and toks[i + 1] == "pytest":
            idx = i + 1
            break
    if idx is None:
        return "no bare 'pytest' token in the test command"

    # Options that consume the following token when not written as --opt=value.
    VALUE = {"-k", "-m", "-p", "-n", "-c", "-o", "-W", "-r", "--tb", "--maxfail", "--timeout",
             "--rootdir", "--junitxml", "--deselect", "--ignore", "--import-mode", "--log-level",
             "--durations", "--confcutdir", "--override-ini", "--dist", "--numprocesses",
             "--basetemp", "--cov", "--cov-report", "--cov-fail-under"}

    rest = toks[idx + 1:]
    i = 0
    while i < len(rest):
        t = rest[i]
        if t == "--":
            i += 1
            continue
        if t.startswith("-"):
            if "=" in t or t in ("-x", "-q", "-v", "-s", "-l"):
                i += 1
                continue
            if t in VALUE:
                i += 2
                continue
            if t.startswith("--") and i + 1 < len(rest) and not rest[i + 1].startswith("-"):
                return ("cannot tell whether '%s' takes a value, so appending test ids might "
                        "not narrow the run" % t)
            i += 1
            continue
        return ("the test command already names a path or test id ('%s'); appending ids would "
                "widen the run, not narrow it" % t)
    return None


# ---------------------------------------------------------------------------------------
# The sweep
# ---------------------------------------------------------------------------------------


class Sweep:
    def __init__(self):
        self.root = ""
        self.git_dir = ""
        self.lock = ""
        self.marker = ""
        self.work = ""
        self.holding_lock = False
        self.proc = None
        self.run_timed_out = False
        self.manifest = []            # [(slot, rel)]
        self.results = []
        self.killers = []
        self.fast_enabled = False
        self.fast_why = ""
        self.fast_cmd_template = ""
        self.fast_iso = {}            # key -> set(ids) red in isolation
        self.fast_iso_ids = None
        self.hintwarn = []
        self.n_unmet = 0

    # -- lock, marker, snapshot, restore --------------------------------------------------

    def snapshot_file(self, rel):
        """The first snapshot of a path is the authoritative one: taken from the tree before
        this sweep touched anything."""
        if any(r == rel for _, r in self.manifest):
            return True
        snapdir = os.path.join(self.lock, "snap")
        os.makedirs(snapdir, exist_ok=True)
        slot = "%04d" % (len(self.manifest) + 1)
        try:
            shutil.copy2(os.path.join(self.root, rel), os.path.join(snapdir, slot))
        except OSError:
            return False
        self.manifest.append((slot, rel))
        with open(os.path.join(self.lock, "manifest"), "a", encoding="utf-8") as fh:
            fh.write("%s\t%s\n" % (slot, rel))
        return True

    def read_manifest(self):
        path = os.path.join(self.lock, "manifest")
        rows = []
        if not os.path.isfile(path):
            return rows
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.rstrip("\n")
                if not line:
                    continue
                parts = line.split("\t", 1)
                if len(parts) == 2 and parts[0]:
                    rows.append((parts[0], parts[1]))
        return rows

    def restore_all(self):
        """Restores every file the manifest names -- not only the ones the current mutation
        touched. Each restore is cmp-verified; a mismatch is the loudest thing this tool says."""
        rows = self.manifest or self.read_manifest()
        if not rows:
            return True
        failed = False
        for slot, rel in rows:
            snap = os.path.join(self.lock, "snap", slot)
            dest = os.path.join(self.root, rel)
            if not os.path.isfile(snap):
                emit_err("%s: MISSING SNAPSHOT for '%s' (%s) -- cannot restore it"
                         % (SELF, rel, snap))
                failed = True
                continue
            try:
                shutil.copy2(snap, dest)
            except OSError:
                emit_err("%s: FAILED TO WRITE '%s' back from %s" % (SELF, rel, snap))
                failed = True
                continue
            if read_bytes(snap) != read_bytes(dest):
                emit_err("%s: RESTORE VERIFICATION FAILED for '%s' (snapshot: %s)"
                         % (SELF, rel, snap))
                failed = True
                continue
            invalidate_bytecode(self.root, rel)
        return not failed

    def release(self):
        if not self.holding_lock:
            return
        try:
            os.remove(self.marker)
        except OSError:
            pass
        shutil.rmtree(self.lock, ignore_errors=True)
        self.holding_lock = False

    # -- running the test command ---------------------------------------------------------

    def kill_run(self):
        proc = self.proc
        if proc is None:
            return
        # Kill the process group we started, by the pgid we own. Never a name match.
        try:
            pgid = os.getpgid(proc.pid)
        except OSError:
            pgid = None
        try:
            if pgid is not None and pgid != os.getpgid(0):
                os.killpg(pgid, signal.SIGTERM)
                try:
                    proc.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    os.killpg(pgid, signal.SIGKILL)
            else:
                proc.terminate()
        except OSError:
            pass
        self.proc = None

    def run_test_cmd(self, log, cmd=None, env_name="pytest", timeout_secs=DEFAULT_TIMEOUT):
        """NO_COLOR and COLUMNS are belt to the ANSI-stripping braces, and COLUMNS is
        load-bearing in its own right: pytest truncates each summary line to the terminal
        width, and a pipe means 80 columns, which silently eats the failure text."""
        cmd = cmd if cmd is not None else self.test_cmd
        self.run_timed_out = False

        # Surefire reports persist between runs, and a mutation that fails to compile writes no
        # new ones. Reading the previous run's passing XML would report that mutation as a
        # survivor. Clear them first so "no reports" means "nothing ran", not "nothing failed".
        # Deliberately narrow: only the XML the classifier reads, so no directory is removed.
        if env_name == "mvn":
            for sub in ("surefire-reports", "failsafe-reports"):
                pattern = os.path.join(self.root, "**", "target", sub, "TEST-*.xml")
                for path in glob.glob(pattern, recursive=True):
                    if os.path.isfile(path):
                        try:
                            os.remove(path)
                        except OSError:
                            pass

        child_env = dict(os.environ)
        child_env["NO_COLOR"] = "1"
        child_env["COLUMNS"] = "1000"

        with open(log, "wb") as out:
            # stdin from /dev/null: a test command inheriting our stdin could eat it.
            self.proc = subprocess.Popen(
                ["bash", "-c", cmd], cwd=self.root, env=child_env,
                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                start_new_session=True)
            proc = self.proc
            try:
                rc = proc.wait(timeout=timeout_secs)
            except subprocess.TimeoutExpired:
                # What `timeout -k 5` did: TERM the group, then KILL it, and report 124.
                self.run_timed_out = True
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
                except OSError:
                    pass
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                    except OSError:
                        pass
                    proc.wait()
                rc = 124
            finally:
                self.proc = None
        return rc

    # -- the fast tier --------------------------------------------------------------------

    def fast_cmd_for(self, ids):
        """Every id is shell-quoted: a parametrized node id can contain spaces, brackets and
        quotes, and it is handed to bash -c."""
        if not ids:
            return None
        joined = "".join(" " + shlex.quote(i) for i in ids)
        pre, _, post = self.fast_cmd_template.partition("{}")
        return pre + joined + post

    def record_killers(self, rows, fast_max):
        """Capped: the point of the subset is that it is quick, and a mutation that reddens 400
        tests would otherwise prime a subset as slow as the suite. First-seen order."""
        if not self.fast_enabled:
            return
        for kind, test_id, _ in rows:
            if kind != "A" or test_id in self.killers:
                continue
            if len(self.killers) >= fast_max:
                return
            self.killers.append(test_id)

    def ensure_iso_baseline(self, subset, env_name, extra_pattern, timeout_secs):
        """A test can pass in the full suite and fail when run alone -- shared state, ordering,
        a fixture another test primed. Scored naively that would be this mutation's kill, and
        would hide a finding. Memoized on the set's contents."""
        key = "\n".join(sorted(subset))
        if key in self.fast_iso:
            self.fast_iso_ids = self.fast_iso[key]
            return True
        cmd = self.fast_cmd_for(subset)
        if cmd is None:
            self.fast_iso_ids = None
            return False
        log = os.path.join(self.work, "iso.%d.log" % len(self.fast_iso))
        self.run_test_cmd(log, cmd, env_name, timeout_secs)
        if self.run_timed_out:
            emit_err("%s: the primed kill set timed out on a clean tree; fast tier off from here."
                     % SELF)
            self.fast_enabled = False
            self.fast_iso_ids = None
            return False
        ids = {r[1] for r in classify(log, env_name, extra_pattern)}
        self.fast_iso[key] = ids
        self.fast_iso_ids = ids
        return True


def read_bytes(path):
    with open(path, "rb") as fh:
        return fh.read()


def invalidate_bytecode(root, rel):
    """Drop any cached bytecode for a source file we just rewrote.

    CPython validates a cached .pyc against the source's (mtime, size). A mutation like
    'A = 1' -> 'A = 2' preserves the size, and a sweep is fast enough -- especially with the
    fast tier -- that the write can land inside the same mtime second as the existing .pyc.
    The test run then imports the PREVIOUS bytecode, so the sweep measures code that is not in
    the tree. When the stale bytecode happens to be the unmutated original, the mutation
    reddens nothing and reports a false finding: the one output this tool must never produce.

    Called on the RESTORE too, not only on the apply. A stale *mutated* .pyc left behind would
    poison the next clean run -- including the fast tier's isolation baseline, which exists
    precisely to establish what is red on an unmutated tree.

    Scoped to '.py'. A compiled language rebuilds through its own build tool, which does its
    own staleness check; there is nothing here we could invalidate correctly on its behalf.
    """
    if not rel.endswith(".py"):
        return
    path = os.path.join(root, rel)
    directory, base = os.path.split(path)
    stem = base[:-3]
    # glob.escape: the stem comes from the mutations file, and a '[' or '*' in a filename must
    # match itself rather than widen this deletion. pytest's assertion-rewritten cache lives
    # under the same '<stem>.<tag>.pyc' name, so this catches that too.
    victims = glob.glob(os.path.join(directory, "__pycache__", glob.escape(stem) + ".*.pyc"))
    legacy = os.path.join(directory, stem + ".pyc")
    if os.path.isfile(legacy):
        victims.append(legacy)
    for victim in victims:
        try:
            os.remove(victim)
        except OSError:
            pass


def git_out(args):
    try:
        r = subprocess.run(["git"] + args, capture_output=True, text=True)
    except OSError:
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        return False


def read_info(lock, key):
    try:
        with open(os.path.join(lock, "info"), "r", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith(key + "="):
                    return line[len(key) + 1:].rstrip("\n")
    except OSError:
        pass
    return ""


def read_project_config(cfg, state):
    """Per-project defaults. An explicit flag always beats the file."""
    if not os.path.isfile(cfg):
        return
    with open(cfg, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.rstrip("\n")
            if not line or line.startswith("#"):
                continue
            key, _, val = line.partition("=")
            key = "".join(key.split())
            if val.startswith(" "):
                val = val[1:]
            if key == "env":
                if not state["env_name"]:
                    state["env_name"] = val
            elif key == "cmd":
                if not state["cmd_override"]:
                    state["cmd_override"] = val
            elif key == "assertion_pattern":
                if not state["assertion_pattern"]:
                    state["assertion_pattern"] = val
            elif key == "timeout":
                if state["timeout_secs"] == str(DEFAULT_TIMEOUT):
                    state["timeout_secs"] = val
            elif key == "fast":
                if state["fast_mode"] == "auto":
                    state["fast_mode"] = val
            elif key == "fast_cmd":
                if not state["fast_cmd_template"]:
                    state["fast_cmd_template"] = val
            elif key == "fast_max":
                if state["fast_max"] == str(DEFAULT_FAST_MAX):
                    state["fast_max"] = val
            else:
                emit_err("%s: %s: ignoring unknown key '%s'" % (SELF, cfg, key))


def resolve_test_cmd(root, cmd_override):
    """The gate's own pytest hook, with the gate's own selection, minus coverage, plus the
    flags classification depends on."""
    if cmd_override:
        test_cmd, source = cmd_override, "--cmd"
    else:
        cfg = os.path.join(root, ".pre-commit-config.yaml")
        if not os.path.isfile(cfg):
            emit_err("%s: no --cmd given, and no .pre-commit-config.yaml in '%s' to take a "
                     "test command from." % (SELF, root))
            raise Exit(1)
        entries = []
        with open(cfg, "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                m = re.match(r"^[ \t]*entry:[ \t]*(.*)$", line.rstrip("\n"))
                if m and re.search(r"(^|[ \t/])pytest([ \t]|$)", m.group(1)):
                    entries.append(m.group(1))
        if not entries:
            emit_err("%s: no pytest hook in %s. Pass the test command with --cmd." % (SELF, cfg))
            raise Exit(1)
        if len(entries) > 1:
            emit_err("%s: %s has %d pytest hooks:" % (SELF, cfg, len(entries)))
            for e in entries:
                emit_err("%s:   %s" % (SELF, e))
            emit_err("%s: refusing to guess which one measures behaviour. Pass one with --cmd."
                     % SELF)
            raise Exit(1)
        # Drop coverage: a --cov-fail-under failing is not a test reddening.
        test_cmd = re.sub(r"(^|[ \t])--cov[^ \t]*", "", entries[0]).rstrip(" \t")
        source = ".pre-commit-config.yaml"

    # Only for a pytest command: any other command is run exactly as given.
    if "pytest" in test_cmd:
        if "-p no:randomly" not in test_cmd:
            test_cmd += " -p no:randomly"
        if "--tb=" not in test_cmd:
            test_cmd += " --tb=line"
        if " -r" not in test_cmd:
            test_cmd += " -rfE"
    return test_cmd, source


def run_cli(sweep, argv):
    st = {"cmd_override": "", "timeout_secs": str(DEFAULT_TIMEOUT), "assertion_pattern": "",
          "env_name": "", "fast_mode": "auto", "fast_cmd_template": "",
          "fast_max": str(DEFAULT_FAST_MAX)}
    mode = "sweep"
    mutations_file = ""
    selected = []

    def need(args, flag):
        if len(args) < 2:
            emit_err("%s: %s needs an argument" % (SELF, flag))
            usage()
            raise Exit(1)

    args = list(argv)
    while args:
        a = args[0]
        if a == "--check":
            mode = "check"; args.pop(0)
        elif a == "--recover":
            mode = "recover"; args.pop(0)
        elif a == "--cmd":
            need(args, "--cmd"); st["cmd_override"] = args[1]; del args[:2]
        elif a == "--timeout":
            need(args, "--timeout"); st["timeout_secs"] = args[1]; del args[:2]
        elif a == "--assertion-pattern":
            need(args, "--assertion-pattern"); st["assertion_pattern"] = args[1]; del args[:2]
        elif a == "--env":
            need(args, "--env"); st["env_name"] = args[1]; del args[:2]
        elif a.startswith("--env="):
            st["env_name"] = a[len("--env="):]; args.pop(0)
        elif a == "--no-fast":
            st["fast_mode"] = "off"; args.pop(0)
        elif a == "--fast-cmd":
            need(args, "--fast-cmd"); st["fast_cmd_template"] = args[1]; del args[:2]
        elif a == "--fast-max":
            need(args, "--fast-max"); st["fast_max"] = args[1]; del args[:2]
        elif a in ("-h", "--help"):
            help_text(); raise Exit(0)
        elif a == "-":
            if not mutations_file:
                mutations_file = "-"
            else:
                selected.append(a)
            args.pop(0)
        elif a.startswith("-"):
            emit_err("%s: unknown option '%s'" % (SELF, a)); usage(); raise Exit(1)
        else:
            if not mutations_file:
                mutations_file = a
            else:
                selected.append(a)
            args.pop(0)

    # After the flags, so an explicit flag always beats the file.
    gd = git_out(["rev-parse", "--git-dir"])
    read_project_config(os.path.join(gd or ".", "info", "git-mutate"), st)
    env_name = st["env_name"] or "pytest"

    if env_name not in ("pytest", "mvn", "go", "rust", "dotnet"):
        die("--env takes one of: pytest, mvn, go, rust, dotnet (got '%s')" % env_name)
    if not st["timeout_secs"].isdigit():
        die("--timeout takes a whole number of seconds, got '%s'" % st["timeout_secs"])
    if st["fast_mode"] not in ("auto", "on", "off"):
        die("fast takes 'on' or 'off' (got '%s')" % st["fast_mode"])
    if not st["fast_max"].isdigit():
        die("--fast-max takes a whole number, got '%s'" % st["fast_max"])
    timeout_secs = int(st["timeout_secs"])
    fast_max = int(st["fast_max"])

    if mode == "recover":
        if mutations_file:
            die("--recover takes no mutations file")
    else:
        if not mutations_file:
            usage(); raise Exit(1)
        if mutations_file != "-" and not os.path.isfile(mutations_file):
            die("no such mutations file: '%s'" % mutations_file)

    root = git_out(["rev-parse", "--show-toplevel"])
    if root is None:
        die("not inside a git repository")
    git_dir = git_out(["rev-parse", "--absolute-git-dir"])
    if git_dir is None:
        die("cannot locate the git directory")
    sweep.root, sweep.git_dir = root, git_dir
    sweep.lock = os.path.join(git_dir, LOCK_BASENAME)
    sweep.marker = os.path.join(root, MARKER_NAME)

    if mode == "recover":
        return do_recover(sweep)

    sweep.work = tempfile.mkdtemp()
    source = mutations_file
    label = "'%s'" % mutations_file
    if mutations_file == "-":
        source = os.path.join(sweep.work, "stdin.toml")
        label = "standard input"
        try:
            with open(source, "wb") as fh:
                fh.write(sys.stdin.buffer.read())
        except OSError:
            die("cannot read mutations from standard input")

    muts = parse_mutations(source, label)

    chosen = [m for m in muts if not selected or m.name in selected]
    for want in selected:
        if not any(m.name == want for m in muts):
            die("no mutation named '%s' in %s" % (want, mutations_file))
    if not chosen:
        die("no mutations selected")
    n_selected = len(chosen)

    if mode == "check":
        return do_check(sweep, chosen, n_selected, mutations_file)

    return do_sweep(sweep, chosen, n_selected, mutations_file, env_name,
                    st["assertion_pattern"], st["cmd_override"], st["fast_mode"],
                    st["fast_cmd_template"], fast_max, timeout_secs)


def do_recover(sweep):
    if not os.path.isdir(sweep.lock):
        die("no sweep state at %s -- nothing to recover" % sweep.lock)
    pid = read_info(sweep.lock, "pid")
    if pid and pid.isdigit() and pid_alive(int(pid)):
        die("a sweep is still running (pid %s). Refusing to restore under a live sweep." % pid)
    rows = sweep.read_manifest()
    if not os.path.isfile(os.path.join(sweep.lock, "manifest")):
        emit_err("%s: the stale sweep had snapshotted nothing; clearing its lock and marker."
                 % SELF)
        try:
            os.remove(sweep.marker)
        except OSError:
            pass
        shutil.rmtree(sweep.lock, ignore_errors=True)
        return 0
    emit("%s: restoring from the snapshot the stale sweep took:" % SELF)
    for slot, rel in rows:
        snap = os.path.join(sweep.lock, "snap", slot)
        dest = os.path.join(sweep.root, rel)
        same = os.path.isfile(snap) and os.path.isfile(dest) \
            and read_bytes(snap) == read_bytes(dest)
        emit("  %s  %s" % ("already identical" if same else "restoring        ", rel))
    sweep.manifest = rows
    sweep.holding_lock = True
    if not sweep.restore_all():
        emit_err("%s: RESTORE FAILED; lock kept at %s." % (SELF, sweep.lock))
        sweep.holding_lock = False
        return 4
    sweep.release()
    emit("%s: tree restored and cmp-verified; lock and marker cleared." % SELF)
    return 0


def do_check(sweep, chosen, n_selected, mutations_file):
    emit("%s --check: %d mutation(s) from %s (no tests run, tree untouched)"
         % (SELF, n_selected, mutations_file))
    refused = 0
    for mut in chosen:
        try:
            order, _ = plan_mutation(sweep.root, mut)
        except Refused as exc:
            emit("  REFUSED  %s  %s" % (mut.name, exc.msg or "(no reason given)"))
            refused += 1
            continue
        hint = ""
        if mut.hints:
            hint = "  [expects %d test(s) to fail]" % len(mut.hints)
        emit("  ok       %s  (%s)%s" % (mut.name, "".join(r + " " for r in order), hint))
    emit()
    if refused:
        emit("%s: %d mutation(s) would be refused; nothing was measured." % (SELF, refused))
        return 3
    emit("%s: every anchor is unique, in code, and changes the file." % SELF)
    return 0


def take_lock(sweep, mutations_file):
    """A second concurrent sweep in the same repo must refuse rather than interleave."""
    try:
        os.mkdir(sweep.lock)
    except FileExistsError:
        pid = read_info(sweep.lock, "pid")
        started = read_info(sweep.lock, "started")
        if pid and pid.isdigit() and pid_alive(int(pid)):
            die("a 'git mutate' sweep is already in flight in '%s' (pid %s, since %s).\n"
                "    Refusing to interleave: the tree can only hold one mutation at a time."
                % (sweep.root, pid, started or "unknown"))
        emit_err("%s: a previous sweep (pid %s, since %s) left state at"
                 % (SELF, pid or "unknown", started or "unknown"))
        emit_err("%s:   %s" % (SELF, sweep.lock))
        emit_err("%s: and is no longer running -- it was killed hard enough that it could not "
                 "restore." % SELF)
        if os.path.isfile(os.path.join(sweep.lock, "manifest")):
            emit_err("%s: it had snapshotted these files, which may still be mutated:" % SELF)
            for _, rel in sweep.read_manifest():
                emit_err("%s:   %s" % (SELF, rel))
        emit_err("%s: run 'git mutate --recover' to restore them from that snapshot and "
                 "cmp-verify." % SELF)
        emit_err("%s: Refusing to restore automatically: a snapshot of unknown age restoring "
                 "silently" % SELF)
        emit_err("%s: would revert real work under the guise of a safety mechanism." % SELF)
        raise Exit(1)

    sweep.holding_lock = True
    host = socket.gethostname()
    started = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    with open(os.path.join(sweep.lock, "info"), "w", encoding="utf-8") as fh:
        fh.write("pid=%d\nhost=%s\nstarted=%s\nmutations=%s\n"
                 % (os.getpid(), host, started, mutations_file))

    # The marker is untracked and deliberately NOT gitignored: its whole job is to be glaring
    # in `git status`, so anything sampling this repo mid-sweep sees why the tree is dirty.
    with open(sweep.marker, "w", encoding="utf-8") as fh:
        fh.write("""A 'git mutate' sweep is in flight in this repository.

  pid:        %d
  host:       %s
  started:    %s
  mutations:  %s

While a mutation is applied, tracked files in this tree are MODIFIED on purpose and the test
gate is RED. Do not conclude anything about this repository's state until the sweep finishes
and this file disappears.

If no such process is running, the sweep was killed before it could restore: run
'git mutate --recover' to put the tree back from the snapshot it took.

This file is untracked and deliberately not gitignored -- it exists to show up in
'git status'. 'git mutate' removes it when the sweep ends.
""" % (os.getpid(), host, started, mutations_file))


def install_signal_handlers(sweep):
    names = {signal.SIGINT: "INT", signal.SIGTERM: "TERM", signal.SIGHUP: "HUP"}

    def handler(signum, frame):
        emit_err("")
        emit_err("%s: %s received -- killing the test command and restoring the tree."
                 % (SELF, names.get(signum, str(signum))))
        sweep.kill_run()
        raise Exit(130)

    for sig in names:
        signal.signal(sig, handler)


def resolve_fast(sweep, env_name, fast_mode, fast_cmd_template, test_cmd):
    if fast_mode == "off":
        sweep.fast_why = "disabled with --no-fast"
        return
    if fast_cmd_template:
        if "{}" not in fast_cmd_template:
            die("--fast-cmd needs a '{}' where the test ids go")
        sweep.fast_cmd_template = fast_cmd_template
        sweep.fast_enabled = True
        return
    if env_name != "pytest":
        sweep.fast_why = ("only the pytest env selects by test id (--env %s); pass --fast-cmd"
                          % env_name)
        return
    if "pytest" not in test_cmd:
        sweep.fast_why = "the test command is not pytest-shaped; pass --fast-cmd"
        return
    why = fast_probe(test_cmd)
    if why:
        sweep.fast_why = why
        return
    sweep.fast_cmd_template = test_cmd + " {}"
    sweep.fast_enabled = True


def first_match(log_path, pattern, limit=160):
    try:
        with open(log_path, "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if pattern.search(line):
                    return ANSI.sub("", line.rstrip("\n").lstrip())[:limit]
    except OSError:
        pass
    return ""


def do_sweep(sweep, chosen, n_selected, mutations_file, env_name, assertion_pattern,
             cmd_override, fast_mode, fast_cmd_template, fast_max, timeout_secs):
    take_lock(sweep, mutations_file)
    install_signal_handlers(sweep)

    test_cmd, test_cmd_source = resolve_test_cmd(sweep.root, cmd_override)
    sweep.test_cmd = test_cmd
    resolve_fast(sweep, env_name, fast_mode, fast_cmd_template, test_cmd)

    emit("%s: %d mutation(s) from %s" % (SELF, n_selected, mutations_file))
    emit("%s: test command (%s): %s" % (SELF, test_cmd_source, test_cmd))
    if sweep.fast_enabled:
        emit("%s: fast tier: on -- once a test has killed, later mutations try that set first;"
             % SELF)
        emit("%s:            an assertion kill there is conclusive. Findings still come from"
             % SELF)
        emit("%s:            the full suite. --no-fast turns this off." % SELF)
    else:
        emit("%s: fast tier: off (%s); every mutation runs the full suite."
             % (SELF, sweep.fast_why or "unavailable"))
        n_hinted = sum(1 for m in chosen if m.hints)
        if n_hinted:
            emit_err("%s: NOTE: %d mutation(s) carry a 'tests' hint, which only the fast tier "
                     "reads." % (SELF, n_hinted))
    emit("%s: sweep in flight; '%s' marks this tree as transiently dirty."
         % (SELF, MARKER_NAME))
    emit()

    # -- baseline -------------------------------------------------------------------------
    baseline_log = os.path.join(sweep.work, "baseline.log")
    baseline_started = datetime.datetime.now().timestamp()
    baseline_rc = sweep.run_test_cmd(baseline_log, test_cmd, env_name, timeout_secs)
    baseline_rows = classify(baseline_log, env_name, assertion_pattern)
    if sweep.run_timed_out:
        die("the unmutated test command timed out after %ds. Nothing can be measured; raise "
            "--timeout." % timeout_secs)
    # A failing baseline that matches no FAILED/ERROR line at all is not "no pre-existing
    # failures" -- it is a suite this classifier cannot read.
    if baseline_rc != 0 and not baseline_rows:
        die("the unmutated test command exited %d but produced no line this classifier\n"
            "recognises as FAILED/ERROR ('%s'). The classifier is pytest-shaped: it cannot "
            "tell a\nreal failure from another runner's output, so no mutation afterwards "
            "would be measurable.\nPass a pytest-compatible command with --cmd."
            % (baseline_rc, test_cmd))
    # A green baseline that executed no tests is the mirror of the case above: nothing is red
    # because nothing ran, and every mutation afterwards would report "reddened nothing".
    baseline_tests = -1
    if baseline_rc == 0:
        baseline_tests = count_tests(baseline_log, baseline_started, env_name)
    if baseline_tests == 0:
        die("the unmutated test command executed 0 tests ('%s'). Nothing is red because\n"
            "nothing ran, so every mutation would report 'reddened nothing' -- a survivor "
            "that was never\nmeasured. Check the test selector: Surefire takes a "
            "comma-separated list, and an unmatched\nselector plus "
            "-Dsurefire.failIfNoSpecifiedTests=false exits green having run nothing."
            % test_cmd)

    if any(k == "E" for k, _, _ in baseline_rows):
        emit_err("%s: the unmutated suite is red with errors:" % SELF)
        for kind, tid, msg in baseline_rows:
            if kind == "E":
                emit_err("%s:  %s  %s" % (SELF, tid, msg))
        emit_err("%s: nothing is measurable while the suite errors -- every mutation would "
                 "look like a kill." % SELF)
        raise Exit(1)

    baseline_ids = [tid for kind, tid, _ in baseline_rows if kind != "E"]
    if baseline_ids:
        emit_err("%s: WARNING: %d test(s) already fail before any mutation:"
                 % (SELF, len(baseline_ids)))
        for tid in baseline_ids:
            emit_err("%s:   %s" % (SELF, tid))
        emit_err("%s: they are excluded from every mutation's kills -- a test already red "
                 "cannot be a kill." % SELF)
        emit_err("")
    baseline_set = set(baseline_ids)

    # -- the sweep ------------------------------------------------------------------------
    for i, mut in enumerate(chosen, start=1):
        idx = "%03d" % i
        res = Result(name=mut.name, hints=list(mut.hints) if mut.hints else None)
        sweep.results.append(res)
        sys.stdout.write("[%d/%d] %s ... " % (i, n_selected, mut.name))
        sys.stdout.flush()

        try:
            order, bufs = plan_mutation(sweep.root, mut)
        except Refused as exc:
            emit("REFUSED: %s" % exc.msg)
            res.status, res.note = "refused", exc.msg
            continue

        # This mutation's candidate set: the caller's "I expect these to fail" first, then
        # everything that has killed so far. Deduped, first-seen order kept.
        subset, seen = [], set()
        for tid in (mut.hints or []) + sweep.killers:
            if tid and tid not in seen:
                seen.add(tid)
                subset.append(tid)

        # Price the candidate set on a CLEAN tree before anything is applied.
        sweep.fast_iso_ids = None
        if sweep.fast_enabled and subset:
            sweep.ensure_iso_baseline(subset, env_name, assertion_pattern, timeout_secs)

        # Snapshot at mutation time, from the tree about to change.
        if not all(sweep.snapshot_file(rel) for rel in order):
            msg = "could not snapshot the files this mutation touches"
            emit("REFUSED: %s" % msg)
            res.status, res.note = "refused", msg
            continue

        for rel in order:
            with open(os.path.join(sweep.root, rel), "wb") as fh:
                fh.write(bufs[rel].encode("utf-8", "surrogateescape"))
            invalidate_bytecode(sweep.root, rel)

        # The fast tier. Only a clean assertion kill short-circuits.
        fast_hit = False
        fast_rows = []
        if sweep.fast_enabled and subset and sweep.fast_iso_ids is not None:
            fcmd = sweep.fast_cmd_for(subset)
            if fcmd:
                flog = os.path.join(sweep.work, "log.%s.fast" % idx)
                f_rc = sweep.run_test_cmd(flog, fcmd, env_name, timeout_secs)
                # pytest exits 4 and collects NOTHING when any id fails to match -- one typo
                # in a 'tests' hint drops the whole subset, valid ids included.
                try:
                    ftext = open(flog, errors="replace").read()
                except OSError:
                    ftext = ""
                if f_rc == 4 or "no match in any of" in ftext or "ERROR: not found:" in ftext:
                    sweep.hintwarn.append("%s: selected no test that could be collected"
                                          % mut.name)
                if not sweep.run_timed_out:
                    rows_all = classify(flog, env_name, assertion_pattern)
                    excl = baseline_set | sweep.fast_iso_ids
                    fast_rows = [r for r in rows_all if r[1] not in excl]
                    f_a = sum(1 for r in fast_rows if r[0] == "A")
                    f_u = sum(1 for r in fast_rows if r[0] == "U")
                    f_c = first_match(flog, COMPILE_RE)
                    if f_a > 0 and f_u == 0 and not f_c:
                        fast_hit = True
                        res.rows_all = rows_all

        if fast_hit:
            mut_rc, timed_out = 1, False
        else:
            log = os.path.join(sweep.work, "log.%s" % idx)
            mut_rc = sweep.run_test_cmd(log, test_cmd, env_name, timeout_secs)
            timed_out = sweep.run_timed_out

        # Restore before doing anything else with the result, so that even a bug in the
        # reporting below cannot leave the tree mutated.
        if not sweep.restore_all():
            raise Exit(4)

        if fast_hit:
            res.rows = fast_rows
            res.n_a = sum(1 for r in fast_rows if r[0] == "A")
            res.n_e = sum(1 for r in fast_rows if r[0] == "E")
            res.n_u = 0
            res.fast = True
            res.status = "killed"
            sweep.record_killers(res.rows, fast_max)
            emit("reddened %d by assertion in the %d-test candidate set -- full suite not run"
                 % (res.n_a, len(subset)))
            continue

        if timed_out:
            emit("TIMED OUT after %ds -- not measured" % timeout_secs)
            res.status = "timeout"
            res.note = ("the test command timed out after %ds; this mutation was not measured"
                        % timeout_secs)
            continue

        res.rows_all = classify(log, env_name, assertion_pattern)
        res.rows = [r for r in res.rows_all if r[1] not in baseline_set] \
            if baseline_set else list(res.rows_all)
        res.n_a = sum(1 for r in res.rows if r[0] == "A")
        res.n_e = sum(1 for r in res.rows if r[0] == "E")
        res.n_u = sum(1 for r in res.rows if r[0] == "U")
        sweep.record_killers(res.rows, fast_max)

        compile_note = first_match(log, COMPILE_RE)
        if not compile_note and res.rows_all:
            for _, _, msg in res.rows_all:
                if re.search(r"Unresolved compilation|cannot be resolved|cannot find symbol",
                             msg):
                    compile_note = msg[:160]
                    break

        if compile_note:
            emit("compilation failed -- not measured")
            res.status = "compile-failed"
            compile_note = re.sub(r"[ \t]*:[ \t]*$", "", compile_note)
            res.note = ("error: compilation failed, so the tests never ran against this "
                        "mutation (%s)" % compile_note)
        elif res.n_u > 0:
            emit("unclassifiable output -- not measured")
            res.status = "unclassified"
            sample = next(("%s - %s" % (r[1], r[2]) for r in res.rows if r[0] == "U"), "")
            res.note = ("%d line(s) matched FAILED/ERROR but carry no failure text we can "
                        "classify (env=%s); first was: %s" % (res.n_u, env_name, sample))
        elif not res.rows_all and mut_rc != 0:
            # The command failed, so this is not a well-defended behaviour -- it is a suite
            # this classifier cannot read. Tested against the UNFILTERED classify output.
            emit("test command exited %d but matched nothing -- not measured" % mut_rc)
            res.status = "unclassified"
            res.note = ("the test command exited %d but produced no FAILED/ERROR line this "
                        "pytest-shaped classifier recognises; pass a pytest-compatible command "
                        "with --cmd" % mut_rc)
        elif res.n_a == 0 and res.n_e == 0:
            emit("reddened nothing")
            res.status = "survived"
        elif res.n_a == 0:
            emit("reddened %d, all by error -- proves nothing" % res.n_e)
            res.status = "error-only"
        else:
            emit("reddened %d: %d by assertion, %d by error"
                 % (res.n_a + res.n_e, res.n_a, res.n_e))
            res.status = "killed"

    return report(sweep, env_name)


# ---------------------------------------------------------------------------------------
# Report. Findings first: a mutation that reddened nothing, or only by error, is the thing
# worth thinking about. No percentage and no score -- "killed 9/10" invites chasing a
# number, "this mutation reddened nothing" invites thought.
# ---------------------------------------------------------------------------------------


def print_rows(res, want, label):
    for kind, tid, msg in res.rows:
        if kind == want:
            emit("      %-9s %s -- %s" % (label, tid, msg))


def section(sweep, title, *wanted):
    """Statuses are printed in the order given, not in file order: a mutation that reddened
    nothing is the finding worth reading first."""
    any_shown = False
    for want in wanted:
        for res in sweep.results:
            if res.status != want:
                continue
            if not any_shown:
                emit()
                emit("== %s ==" % title)
                any_shown = True
            if res.status == "survived":
                emit("  %s: reddened nothing." % res.name)
                emit("      No test in this run distinguishes the mutated code from the "
                     "original.")
            elif res.status == "error-only":
                emit("  %s: reddened %d, ALL BY ERROR -- proves nothing." % (res.name, res.n_e))
                emit("      An error kill says the mutation broke the code, not that a test "
                     "checks the behaviour.")
                print_rows(res, "E", "error")
            elif res.status == "refused":
                emit("  %s: REFUSED -- %s" % (res.name, res.note))
            elif res.status in ("timeout", "unclassified", "compile-failed"):
                emit("  %s: NOT MEASURED -- %s" % (res.name, res.note))
            elif res.status == "killed":
                if res.fast:
                    emit("  %s: reddened %d by assertion in the candidate set."
                         % (res.name, res.n_a))
                    emit("      The full suite was not run: one assertion kill settles it, and "
                         "more tests")
                    emit("      can only add kills. The rows below are that subset's, not the "
                         "suite's.")
                else:
                    emit("  %s: reddened %d -- %d by assertion, %d by error."
                         % (res.name, res.n_a + res.n_e, res.n_a, res.n_e))
                print_rows(res, "A", "assertion")
                print_rows(res, "E", "error")


def hint_rows(tid, rows):
    """The rows for the test a hint names. A bare id names every parametrization of it --
    that is what pytest selects for it -- so 'test_foo' owns 'test_foo[case]'. The '[' is the
    boundary: 'test_foo' must not own 'test_foobar[case]', and 'test_foo[a]' owns only itself.
    """
    return [r for r in rows if r[1] == tid or r[1].startswith(tid + "[")]


def expectations(sweep):
    """An expectation the caller stated and the run did not bear out. NOT a finding about the
    code -- the mutation may well have been killed, by some other test -- but a finding about
    the caller's model of their own suite, and otherwise invisible.

    Deliberately kept out of the exit status. "This behaviour is undefended" (2) and "your
    guess about which test defends it was wrong" are different claims.
    """
    any_shown = False
    for res in sweep.results:
        if not res.hints:
            continue
        # Only where a verdict was actually measured: after a refusal or a compile failure the
        # hint obviously did not redden, and saying so would be noise, not news.
        if res.status not in ("killed", "survived", "error-only"):
            continue
        for tid in res.hints:
            mine = hint_rows(tid, res.rows)
            if any(k == "A" for k, _, _ in mine):
                continue
            errored = [i for k, i, _ in mine if k == "E"]
            if errored:
                kind = "failed only by error, which proves nothing about the behaviour"
                params = [i[len(tid):] for i in errored if i != tid]
                if params:
                    kind += " -- errored in %s, and no parametrization failed by assertion" \
                        % ", ".join(params)
            else:
                kind = "passed"
            if not any_shown:
                emit()
                emit("== EXPECTATIONS NOT MET -- a test you named did not fail ==")
                any_shown = True
            sweep.n_unmet += 1
            emit("  %s: expected '%s' to fail; it %s." % (res.name, tid, kind))
    if any_shown:
        emit("      Each mutation's own verdict above stands -- something else may well have")
        emit("      killed it. What is wrong here is the expectation, not the measurement.")


def report(sweep, env_name):
    if sweep.hintwarn:
        emit_err("")
        emit_err("%s: a 'tests' hint selected nothing pytest could collect, so these mutations"
                 % SELF)
        emit_err("%s: fell through to the full suite. The verdicts are sound; the hint is not:"
                 % SELF)
        for line in sweep.hintwarn:
            emit_err("%s:   %s" % (SELF, line))
        emit_err("%s: pytest collects NOTHING when any id fails to match, so one stale id"
                 % SELF)
        emit_err("%s: disables the fast tier for that mutation entirely." % SELF)

    emit()
    emit("======================================================================")
    section(sweep, "FINDINGS -- read these first", "survived", "error-only")
    section(sweep, "NOT MEASURED -- the sweep is incomplete here",
            "refused", "unclassified", "timeout", "compile-failed")
    section(sweep, "KILLED BY ASSERTION", "killed")
    expectations(sweep)
    emit()

    def count(*wanted):
        return sum(1 for r in sweep.results if r.status in wanted)

    n_findings = count("survived", "error-only")
    n_unmeasured = count("refused", "timeout", "unclassified", "compile-failed")
    n_killed = count("killed")

    unmet_note = ", %d expectation(s) not met" % sweep.n_unmet if sweep.n_unmet else ""
    emit("%s: %d killed by assertion, %d finding(s), %d not measured%s."
         % (SELF, n_killed, n_findings, n_unmeasured, unmet_note))

    if n_unmeasured > 0:
        return 3
    if n_findings > 0:
        return 2
    return 0


def cleanup(sweep, rc):
    """The single exit path. Whatever happened above, the tree goes back first."""
    sweep.kill_run()
    if sweep.holding_lock:
        if not sweep.restore_all():
            emit_err("")
            emit_err("%s: ============================================================================"
                     % SELF)
            emit_err("%s: RESTORE FAILED. THE WORKING TREE MAY STILL BE MUTATED." % SELF)
            emit_err("%s: Snapshots are in %s/snap (see %s/manifest)."
                     % (SELF, sweep.lock, sweep.lock))
            emit_err("%s: The lock and marker are being kept on purpose so nothing else samples this"
                     % SELF)
            emit_err("%s: tree; 'git mutate --recover' retries the restore. Do NOT commit until it is clean."
                     % SELF)
            emit_err("%s: ============================================================================"
                     % SELF)
            if sweep.work:
                shutil.rmtree(sweep.work, ignore_errors=True)
            return 4
        sweep.release()
    if sweep.work:
        shutil.rmtree(sweep.work, ignore_errors=True)
    return rc


def main(argv):
    sweep = Sweep()
    rc = 0
    try:
        rc = run_cli(sweep, argv)
    except Exit as exc:
        rc = exc.code
    except BrokenPipeError:
        # `head` can SIGPIPE the sweep mid-mutation; the cleanup below is the whole point.
        rc = 141
    return cleanup(sweep, rc)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
