@dataclass
class Edit:
    file: str
    old: str
    new: str


@dataclass
class Mutation:
    name: str
    edits: list
    hints: Optional[list] = None


@dataclass
class Result:
    """One mutation's outcome. In the bash implementation this was ten sidecar files."""

    name: str
    hints: Optional[list] = None
    status: str = ""
    note: str = ""
    rows: list = field(default_factory=list)      # [(kind, test_id, message)]
    rows_all: list = field(default_factory=list)
    n_a: int = 0
    n_e: int = 0
    n_u: int = 0
    fast: bool = False


def parse_mutations(src, label):
    """The TOML schema, with every check the bash py_parse made, in the same order."""

    def bad(msg):
        print("%s: %s" % (SELF, msg), file=sys.stderr)
        raise Exit(1)

    try:
        with open(src, "rb") as fh:
            doc = tomllib.load(fh)
    except OSError as exc:
        bad("cannot read %s: %s" % (label, exc))
    except tomllib.TOMLDecodeError as exc:
        bad("%s is not valid TOML: %s" % (label, exc))

    muts = doc.get("mutation")
    if not isinstance(muts, list) or not muts:
        bad("%s declares no [[mutation]] tables" % label)

    out = []
    seen = set()
    for i, mut in enumerate(muts, start=1):
        if not isinstance(mut, dict):
            bad("mutation %d is not a table" % i)
        name = mut.get("name")
        if not isinstance(name, str) or not name.strip():
            bad("mutation %d has no 'name'" % i)
        if any(c in name for c in "/\t\n"):
            bad("mutation name %r may not contain '/', a tab or a newline" % name)
        if name in seen:
            bad("duplicate mutation name %r -- names identify mutations in the report" % name)
        seen.add(name)

        # Two spellings of the same thing. The overwhelming majority of mutations are a
        # single edit, and making those carry a [[mutation.edit]] table is ceremony that buys
        # nothing: 'file'/'old'/'new' sit directly in the [[mutation]]. The table form stays
        # for the case it was invented for -- several edits applied as one mutation.
        # They do not mix inside one [[mutation]], because there is no sensible reading of a
        # mutation that has both, and guessing one would silently drop an edit.
        edits = mut.get("edit")
        inline = [k for k in ("file", "old", "new") if k in mut]
        if edits is not None and inline:
            bad("mutation %r gives both [[mutation.edit]] and a top-level %s -- use one form "
                "or the other" % (name, ", ".join("'%s'" % k for k in inline)))
        flat = edits is None
        if flat:
            if not inline:
                bad("mutation %r has no edit: give it 'file', 'old' and 'new' directly, or "
                    "one or more [[mutation.edit]] tables" % name)
            edits = [mut]
        elif not isinstance(edits, list) or not edits:
            bad("mutation %r has no [[mutation.edit]] tables" % name)

        # Optional: the caller's own "I expect these to fail". A hint, never a filter -- it only
        # decides which tests the fast tier tries FIRST, and a hint that reddens nothing falls
        # through to the full suite like any other subset. So a wrong hint costs time, not truth.
        hints = mut.get("tests")
        if hints is not None:
            if not isinstance(hints, list) or not hints:
                bad("mutation %r: 'tests' must be a non-empty array of test ids" % name)
            for t in hints:
                if not isinstance(t, str) or not t.strip():
                    bad("mutation %r: every entry in 'tests' must be a non-empty string" % name)
                if any(c in t for c in "\t\n"):
                    bad("mutation %r: test id %r may not contain a tab or a newline" % (name, t))

        parsed_edits = []
        for j, edit in enumerate(edits, start=1):
            # The flat form has no edit number to report, and inventing "edit 1/1" for it
            # would point the reader at a table that is not in their file.
            where = "mutation %r" % name if flat else "mutation %r edit %d" % (name, j)
            if not isinstance(edit, dict):
                bad("%s is not a table" % where)
            for key in ("file", "old", "new"):
                if not isinstance(edit.get(key), str):
                    bad("%s is missing a string '%s'" % (where, key))
            rel = edit["file"]
            if not rel or os.path.isabs(rel) or any(c in rel for c in "\t\n"):
                bad("%s: file %r must be a relative path with no tab or newline" % (where, rel))
            if os.path.normpath(rel).startswith(".."):
                bad("%s: file %r escapes the repository" % (where, rel))
            if not edit["old"]:
                bad("%s: 'old' is empty; there is no such thing as an anchor that matches "
                    "everywhere" % where)
            parsed_edits.append(Edit(rel, edit["old"], edit["new"]))

        out.append(Mutation(name, parsed_edits, hints))
    return out


class Refused(Exception):
    def __init__(self, msg):
        self.msg = msg


def comment_verdict(buf, idx, old, rel=""):
    """Crude, stated heuristic for 'this anchor is prose, not code'.

    Catches: an anchor preceded by a '#' on its own line, an anchor that is itself a '#'
    comment, and -- in '.py' only -- an anchor inside a triple-quoted block (the real case:
    a stale anchor that now matches only a docstring, mutating prose, reddening nothing,
    and reporting a false finding).
    Misses: // and /* */ comments, and '#' inside a string literal on the same line. It
    can also false-positive on a file whose triple quotes are unbalanced by a raw string.

    Triple quotes are not Python's alone -- TOML has them too -- so the test is scoped by
    what the block MEANS, with the file suffix as the crude proxy.
    """
    line_start = buf.rfind("\n", 0, idx) + 1
    if "#" in buf[line_start:idx]:
        return "the anchor sits after a '#' on its line (comment)"
    if old.lstrip().startswith("#"):
        return "the anchor is itself a '#' comment"
    if rel.endswith(".py"):
        before = buf[:idx]
        if before.count('"""') % 2 or before.count("'''") % 2:
            return "the anchor sits inside a triple-quoted block (docstring or string literal)"
    return None


def read_text(path):
    with open(path, "rb") as fh:
        return fh.read().decode("utf-8", "surrogateescape")


def plan_mutation(root, mut):
    """Guard one mutation and plan it. Touches nothing; returns (order, {rel: new_text}).

    Every edit is guarded, with no privileged first one. Edits are applied to an in-memory
    buffer in declaration order, and each edit's uniqueness is checked against the buffer as
    it will actually be patched -- so a second edit whose anchor became ambiguous (or vanished)
    because of the first is caught too.
    """
    total = len(mut.edits)
    orig, bufs, order = {}, {}, []

    for j, edit in enumerate(mut.edits, start=1):
        rel, old, new = edit.file, edit.old, edit.new
        where = "edit %d/%d" % (j, total)
        if rel not in bufs:
            path = os.path.join(root, rel)
            if not os.path.isfile(path):
                raise Refused("%s: '%s' is not a file in this repository" % (where, rel))
            try:
                orig[rel] = read_text(path)
            except OSError as exc:
                raise Refused("%s: cannot read '%s': %s" % (where, rel, exc))
            bufs[rel] = orig[rel]
            order.append(rel)

        if new == old:
            raise Refused("%s: 'new' is identical to 'old' in '%s' -- a no-op by construction"
                          % (where, rel))

        count = bufs[rel].count(old)
        if count != 1:
            raise Refused("%s: anchor occurs %dx in '%s', must occur exactly once%s"
                          % (where, count, rel,
                             " (an earlier edit of this mutation may have changed it)"
                             if j > 1 else ""))

        idx = bufs[rel].index(old)
        verdict = comment_verdict(bufs[rel], idx, old, rel)
        if verdict is not None:
            line_no = bufs[rel].count("\n", 0, idx) + 1
            raise Refused("%s: %s (%s:%d) -- mutating prose proves nothing; pick an anchor in code"
                          % (where, verdict, rel, line_no))

        bufs[rel] = bufs[rel][:idx] + new + bufs[rel][idx + len(old):]

    # The backstop. count == 1 and new != old still do not prove the tree changed; this does,
    # and it catches cases neither of those anticipate (for instance two edits that cancel out).
    if not [rel for rel in order if bufs[rel] != orig[rel]]:
        raise Refused("every edit applied, yet the file content is byte-identical to the tree -- "
                      "this mutation changes nothing")

    return order, bufs


