# Usage:
#   git dispatch [--dry-run] [--agent claude|codex|omp|cursor] [--effort LEVEL] [--cwd DIR] <task file>
#
#   Read a task file (<project root>/<repo>/context/TASK_<name>.md), set up its checkout
#   (<project root>/<repo>@<slug> on task/<slug>, from its 'Checkout: <repo>@<slug>' line), and
#   exec the worker in the project root:
#     no session id  ->  claude --effort high 'Task: <repo>/context/TASK_<name>.md'
#                        codex -c model_reasoning_effort="high" 'Task: ...'   (with --agent codex)
#                        omp 'Task: ...'     (with --agent omp; no effort level, no resume)
#                        agent 'Task: ...'   (with --agent cursor; cursor's program is 'agent',
#                                             and it takes no effort level)
#     a session id   ->  claude --effort high --resume <id> 'Follow-up task: ...'
#                        codex resume -c model_reasoning_effort="high" -C <cwd> <id> 'Follow-up task: ...'
#                        agent --resume <id> 'Follow-up task: ...'
#                        the program named by the 'Harness' line: claude-code, codex or cursor
#     ... and a report ->  'Continue task: <path> - read it from the end.'
#
#   A session id with a '## Report' (or '## Report <n>') heading in the file, outside a fenced code
#   block, is the same task continued: the worker already has it, and what is new is at the end.
#   With no report it is a new task routed to an existing worker.
#
#   The session is resumed by the program that ran it, which only the 'Harness' line says. The
#   'Implementer' line is a model name, and a model does not say which program ran it (Claude
#   Opus from Claude Code, Cursor or agy alike), so it is never read.
#
#   --dry-run    Print each step -- the project root and where it came from (dispatch.root
#                or the default), the worktree command, the task file's move and link (with
#                dispatch.moveTask), the agent's exact argv and its cwd -- and change nothing.
#   --agent A    claude, codex, omp or cursor. Resumes a session whose header has no Harness line
#                (omp cannot resume); for a new session, picks the agent (default claude).
#                cursor runs the 'agent' program. Contradicting a Harness is refused.
#   --effort L   The worker's reasoning effort, on a new session and a resume alike (default:
#                high). The worker acts on its first message at once, so the level is always
#                passed explicitly rather than left to whatever the agent's own setting is.
#                claude takes low, medium, high, xhigh or max; codex takes those or ultra
#                (whether the model offers a level is the model's business). omp and cursor take
#                none, so --effort with either is refused rather than dropped.
#   --cwd DIR    Start or resume the agent in DIR instead of the project root, for sessions
#                started elsewhere before this tool existed. The message then names the task
#                file relative to DIR.
#
# Every agent starts in the project root, because a session is found for resuming from where it
# was started (Claude Code before v2.1.223; Codex asks when the directories differ), and the
# project root is the one directory that outlives every task's worktree. See README.md.
#
# The project root is the directory of the main checkout, unless `git config dispatch.root`
# names another one. That directory must already exist, and it must not be the main checkout
# or inside it. It is also refused when .git-report-deps lists a relative path: those resolve
# from a sibling of the main checkout, so a worktree placed elsewhere would break git report.
# Unset, the root is that parent directory, as before. --cwd still overrides the agent's cwd.
#
# With dispatch.root set and `git config dispatch.moveTask true`, the task file moves into its
# checkout: the first dispatch moves <main>/context/TASK_<name>.md to <root>/<repo>@<slug>/context/
# and leaves a relative symlink at the original path, and the message names the moved file
# (<repo>@<slug>/context/TASK_<name>.md from the root). A later dispatch names the same main-checkout
# path and reads through the link; nothing moves again. A link that points anywhere else or
# dangles, a regular file in both places, a destination that already exists, or the checkout's copy
# named directly, is refused before any change. Unset, false, or without dispatch.root, the task
# file stays where it is and nothing below differs.
#
# The task file is otherwise read, never written. Only a status of Pending or Returned is dispatched. An
# existing worktree is reused exactly as it is; a task/<slug> branch without its worktree is
# refused. Everything is checked before the first change, and every refusal exits 1 naming its
# cause.
#
# The branch a new worktree starts from: git config dispatch.defaultBranch if set, else the
# branch origin/HEAD names, else whichever one of 'main' and 'master' exists -- always the local
# branch as it stands, never origin's copy of it.

set -u

SELF="git-dispatch"
STATUSES=("Proposal" "Pending" "In Progress" "Finished" "Author Verified" "Blocked" "Returned" "Closed")
FENCE_RE='^ {0,3}(`{3,}|~{3,})'
FENCE_CLOSE_RE='^ {0,3}(`{3,}|~{3,})[[:space:]]*$'
REPORT_RE='^## Report( [0-9]+)?[[:space:]]*$'
UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
NAME_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
DEFAULT_EFFORT="high"
# From 'claude --help' ("--effort <level> ... (low, medium, high, xhigh, max)"), and Codex's config
# reference for model_reasoning_effort ("such as low, medium, high, xhigh, max, or ultra").
CLAUDE_EFFORTS=(low medium high xhigh max)
CODEX_EFFORTS=(low medium high xhigh max ultra)

usage() {
    cat >&2 <<'EOF'
Usage:
  git dispatch [--dry-run] [--agent claude|codex|omp|cursor] [--effort LEVEL] [--cwd DIR] <task file>
                Set up the task's checkout (<repo>@<slug>, on task/<slug>) and start or resume
                its worker in the project root (the main checkout's parent, or dispatch.root).
  --dry-run     Print the root and where it came from, the worktree command, the agent's
                argv and its cwd; change nothing.
  --agent A     claude, codex, omp or cursor; picks a new session's agent (default claude), and
                names the one to resume when the header has no Harness line (omp cannot resume).
                cursor runs the 'agent' program.
  --effort L    The worker's reasoning effort (default: high). claude: low, medium, high,
                xhigh, max; codex: the same, or ultra. omp and cursor take none; --effort
                with either is refused.
  --cwd DIR     Run the agent in DIR instead of the project root (older sessions).
EOF
}

die() {
    echo "$SELF: $*" >&2
    exit 1
}

usage_error() {
    echo "$SELF: $*" >&2
    usage
    exit 2
}

dry_run=0 agent_opt="" cwd_opt="" task="" seen_agent=0 seen_cwd=0
effort=$DEFAULT_EFFORT seen_effort=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run) dry_run=1 ;;
        --agent|--cwd|--effort)
            [ "$#" -ge 2 ] || usage_error "$1 needs a value"
            case "$1" in
                --agent)
                    [ "$seen_agent" -eq 0 ] || usage_error "--agent given twice"
                    seen_agent=1; agent_opt=$2
                    ;;
                --cwd)
                    [ "$seen_cwd" -eq 0 ] || usage_error "--cwd given twice"
                    seen_cwd=1; cwd_opt=$2
                    ;;
                --effort)
                    [ "$seen_effort" -eq 0 ] || usage_error "--effort given twice"
                    seen_effort=1; effort=$2
                    ;;
            esac
            shift
            ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) usage_error "unknown option '$1'" ;;
        *)
            [ -z "$task" ] || usage_error "one task file, not several ('$task', '$1')"
            task=$1
            ;;
    esac
    shift
done
if [ "$#" -gt 0 ]; then
    [ -z "$task" ] && [ "$#" -eq 1 ] || usage_error "one task file, not several"
    task=$1
fi
[ -n "$task" ] || usage_error "no task file given"
case "$agent_opt" in
    ""|claude|codex|omp|cursor) ;;
    *) usage_error "--agent must be 'claude', 'codex', 'omp' or 'cursor', not '$agent_opt'" ;;
esac
if [ "$seen_cwd" -eq 1 ] && [ -z "$cwd_opt" ]; then
    usage_error "--cwd needs a directory"
fi

# These make every git command below, and every one the agent runs, act on a repository the task
# file did not name. The repository comes from the task file, so a set one is refused rather than
# quietly overridden.
for var in GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE; do
    [ -z "${!var+set}" ] || die "$var is set ('${!var}'); the repository comes from the task file -- unset it"
done

# --- the task file --------------------------------------------------------------------------

# dispatch.moveTask (with dispatch.root, which it needs) as the task's repository sets it.
move_task_set() {
    [ "$(git -C "$1" config --get --bool dispatch.moveTask 2>/dev/null)" = "true" ] &&
        git -C "$1" config --get dispatch.root > /dev/null 2>&1
}

# A dangling link is a moved task whose checkout is gone. That is said once the repository is
# known, below; without dispatch.moveTask it is a missing file, as it always was.
task_dangling=0
if [ ! -e "$task" ] && [ -L "$task" ] && move_task_set "$(dirname -- "$task")"; then
    task_dangling=1
else
    [ -f "$task" ] || die "no such task file: $task"
    [ -r "$task" ] || die "cannot read the task file: $task"
fi
task_base=$(basename -- "$task")
case "$task_base" in
    TASK_?*.md) ;;
    *) die "$task: a task file is named TASK_<name>.md" ;;
esac
task_dir=$(cd -- "$(dirname -- "$task")" && pwd -P) || die "cannot enter the task file's directory"
task_abs="$task_dir/$task_base"

# The main checkout is the working tree of the repository's common git dir -- the same answer from
# any of its worktrees. That is '<checkout>/.git' for a plain repo, but a submodule's common dir is
# <super>/.git/modules/<name>, whose checkout only its core.worktree names (and which git 2.34's
# 'worktree list' reports as the git dir itself).
common=$(git -C "$task_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
    die "$task: not inside a git repository"
[ "$(git --git-dir="$common" config --bool core.bare)" != "true" ] ||
    die "$task: the repository ($common) is bare; a task needs a main checkout"
if core_wt=$(git --git-dir="$common" config core.worktree); then
    main=$(cd -- "$common" && cd -- "$core_wt" && pwd -P) ||
        die "$task: cannot enter the main checkout ($common has core.worktree '$core_wt')"
elif [ "$(basename -- "$common")" = ".git" ]; then
    main=$(dirname -- "$common")
else
    die "$task: cannot tell the main checkout of $common (not '<checkout>/.git', no core.worktree)"
fi
listing=$(git -C "$main" worktree list --porcelain) || die "cannot list the worktrees of $main"
repo=$(basename -- "$main")
# Unset, the root is the main checkout's parent and every path below is the one it has
# always been. Set, both the worktree and the agent's cwd (unless --cwd overrides the cwd)
# use this directory instead: a checkout that lives among unrelated repos would otherwise
# share their parent. Resolved once, here, so a Returned task's reuse and a resume look
# at the same place a new worktree is created.
root=$(dirname -- "$main")
root_from="default: the main checkout's parent"
if root_cfg=$(git -C "$main" config --get dispatch.root); then
    root_cfg=${root_cfg%$'\r'}
    if [ -z "$root_cfg" ]; then
        die "dispatch.root is empty; set it to a directory ('git -C $main config dispatch.root <dir>')" \
            "or unset it ('git -C $main config --unset dispatch.root')"
    fi
    # A relative value is resolved from the main checkout, the repository the config
    # belongs to, not from whatever directory the command was run in. Absolute or
    # relative, the root is then the physical path.
    if [ "${root_cfg#/}" = "$root_cfg" ]; then
        root_candidate=$main/$root_cfg
    else
        root_candidate=$root_cfg
    fi
    if [ ! -d "$root_candidate" ]; then
        if [ -e "$root_candidate" ] && [ ! -L "$root_candidate" ]; then
            die "dispatch.root '$root_cfg' is not a directory; point it at a directory" \
                "('git -C $main config dispatch.root <dir>'), or unset it" \
                "('git -C $main config --unset dispatch.root')"
        fi
        die "dispatch.root '$root_cfg' does not exist; create that directory, or unset it with" \
            "'git -C $main config --unset dispatch.root'"
    fi
    root=$(cd -- "$root_candidate" && pwd -P) ||
        die "dispatch.root '$root_cfg' cannot be entered"
    main_phys=$(cd -- "$main" && pwd -P) || die "cannot enter the main checkout ($main)"
    if [ "$root" = "$main_phys" ]; then
        die "dispatch.root '$root' is the main checkout; a worktree nested in its own repo pollutes it." \
            "Set it to a directory outside the checkout ('git -C $main config dispatch.root <dir>')"
    elif [[ "$root" == "$main_phys"/* ]]; then
        die "dispatch.root '$root' is inside the main checkout ($main_phys); a worktree nested in its" \
            "own repo pollutes it. Set it to a directory outside the checkout" \
            "('git -C $main config dispatch.root <dir>')"
    fi
    # .git-report-deps entries are paths relative to the worktree (git-report joins each one
    # onto it). Beside the main checkout, ../dep is the sibling the main checkout sees; under
    # any other root it is not. Blank lines and comments, which git-report ignores, are not
    # entries. Checked here, before any worktree is added.
    deps_file=$main/.git-report-deps
    if [ -f "$deps_file" ]; then
        while IFS= read -r deps_line || [ -n "$deps_line" ]; do
            deps_line=${deps_line%$'\r'}
            deps_trim=${deps_line#"${deps_line%%[![:space:]]*}"}
            deps_trim=${deps_trim%"${deps_trim##*[![:space:]]}"}
            [ -n "$deps_trim" ] || continue
            [ "${deps_trim:0:1}" = "#" ] && continue
            die "dispatch.root is set ($root) but $deps_file lists a relative path ('$deps_trim');" \
                "it resolves only from a sibling of the main checkout, so git report would break" \
                "in the worktree. Remove that path, or unset dispatch.root with" \
                "'git -C $main config --unset dispatch.root'"
        done < "$deps_file"
    fi
    root_from="git config dispatch.root"
fi

# dispatch.moveTask is read only under dispatch.root: the move exists so that a task outside the
# root is not named absolutely. Unset, the task file stays where it is.
move_task=0
if [ "$root_from" = "git config dispatch.root" ]; then
    move_cfg=$(git -C "$main" config --get --bool dispatch.moveTask 2>&1)
    case $? in
        0) [ "$move_cfg" = "true" ] && move_task=1 ;;
        1) ;;
        *) die "dispatch.moveTask: $move_cfg; set it to true or false, or unset it" \
               "('git -C $main config --unset dispatch.moveTask')" ;;
    esac
fi

# CO writes the task into the main checkout's context/, and the message names it there. A copy
# elsewhere -- a worktree's own context/, say -- is a different file the worker would never see.
# With dispatch.moveTask the task is always named by that path, even once it has moved: the file
# in the checkout is reached through the link, never named directly, so one entry point keeps
# one rule.
if [ "$move_task" -eq 1 ]; then
    main_ctx=$(cd -- "$main/context" 2> /dev/null && pwd -P) ||
        die "$task: not the task file in the main checkout ($main/context/$task_base)"
    task_main="$main_ctx/$task_base"
    if [ "$task_dir" != "$main_ctx" ]; then
        case "$task_dir" in
            "$root/$repo@"*/context)
                die "$task: this is a checkout's copy of the task; dispatch it by its path in the" \
                    "main checkout ($main/context/$task_base)" ;;
        esac
        die "$task: not the task file in the main checkout ($main/context/$task_base)"
    fi
    if [ "$task_dangling" -eq 1 ]; then
        die "$task: a link to '$(readlink -- "$task_main")', which does not exist: the task's" \
            "worktree, and the task file with it, is gone"
    fi
else
    [ "$task_dangling" -eq 0 ] || die "no such task file: $task"
    [ "$main/context/$task_base" -ef "$task_abs" ] ||
        die "$task: not the task file in the main checkout ($main/context/$task_base)"
fi

# The header is line 3 up to the first blank line. Only it is read: the body may quote the header
# format itself (this tool's own task file does), and a 'Checkout:' found there is not the task's.
header=()
lineno=0
while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line=${line%$'\r'}
    [ "$lineno" -lt 3 ] && continue
    [ -z "${line//[[:space:]]/}" ] && break
    header+=("$lineno:$line")
done < "$task"
[ "${#header[@]}" -gt 0 ] || die "$task: no header at line 3 (expected '**Status: ...**')"
last=${header[${#header[@]}-1]}
header_range="lines 3-${last%%:*}"

declare -A field field_line
for entry in "${header[@]}"; do
    n=${entry%%:*}
    line=${entry#*:}
    line=${line%"${line##*[![:space:]]}"}
    if [[ "$line" =~ ^\*\*([^*:]+):\ *(.*[^[:space:]])\ *\*\*$ ]]; then
        key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    elif [[ "$line" =~ ^\*\*([^*:]+):\ *\*\*$ ]]; then
        key=${BASH_REMATCH[1]} value=""
    else
        continue
    fi
    [ -z "${field[$key]+set}" ] ||
        die "$task: line $n: a second '$key:' line (the first is line ${field_line[$key]})"
    field[$key]=$value
    field_line[$key]=$n
done

status_line=${header[0]#*:}
[ "${field_line[Status]:-}" = 3 ] ||
    die "$task: line 3 is not the status (expected '**Status: <status>**', got '$status_line')"
status=${field[Status]}
known=0
for s in "${STATUSES[@]}"; do [ "$s" = "$status" ] && known=1; done
[ "$known" -eq 1 ] || die "$task: line 3: unknown status '$status'"
case "$status" in
    Pending|Returned) ;;
    *) die "$task: line 3: status is '$status'; only a Pending or Returned task is dispatched" ;;
esac

for key in "Implementer Session ID" "Checkout"; do
    [ -n "${field[$key]+set}" ] ||
        die "$task: no '**$key: ...**' line in the header ($header_range)"
done
session=${field[Implementer Session ID]}
checkout=${field[Checkout]}
l_session=${field_line[Implementer Session ID]}
l_checkout=${field_line[Checkout]}

[[ "$checkout" =~ ^([^@]+)@([^@]+)$ ]] ||
    die "$task: line $l_checkout: malformed Checkout '$checkout' (expected '<repo>@<slug>')"
co_repo=${BASH_REMATCH[1]} slug=${BASH_REMATCH[2]}
[[ "$co_repo" =~ $NAME_RE ]] ||
    die "$task: line $l_checkout: malformed Checkout '$checkout': '$co_repo' is not a repository directory name"
[[ "$slug" =~ $NAME_RE ]] && git check-ref-format "refs/heads/task/$slug" ||
    die "$task: line $l_checkout: malformed Checkout '$checkout': 'task/$slug' is not a valid branch name"
[ "$co_repo" = "$repo" ] ||
    die "$task: line $l_checkout: Checkout names repo '$co_repo', but the task file is in '$repo' ($main)"

# --- the agent ------------------------------------------------------------------------------

# The program that ran the session, from the Harness line. claude-code, codex and cursor can be
# resumed from here (omp starts a session but cannot resume one); anything else is named and
# refused rather than guessed at. cursor's command-line program is 'agent', not 'cursor'.
harness="" harness_agent=""
if [ -n "${field[Harness]+set}" ]; then
    harness=${field[Harness]}
    l_harness=${field_line[Harness]}
    case "$harness" in
        claude-code) harness_agent=claude ;;
        codex) harness_agent=codex ;;
        omp) harness_agent=omp ;;
        cursor) harness_agent=cursor ;;
        unassigned) harness="" ;;
        "") die "$task: line $l_harness: empty Harness (write 'unassigned' for none)" ;;
        *)
            if [ "$session" = "unassigned" ]; then
                die "$task: line $l_harness: Harness '$harness' is not a program git dispatch starts" \
                    "(claude-code, codex, omp, cursor); start it in $harness, or set Harness to unassigned"
            fi
            die "$task: line $l_harness: Harness '$harness' cannot be resumed from the command line;" \
                "resume it in $harness, or dispatch a new session"
            ;;
    esac
    if [ -n "$agent_opt" ] && [ -n "$harness_agent" ] && [ "$agent_opt" != "$harness_agent" ]; then
        die "$task: line $l_harness: Harness is '$harness'; --agent $agent_opt contradicts it"
    fi
fi

if [ "$session" = "unassigned" ]; then
    resume=0
    agent=${agent_opt:-${harness_agent:-claude}}
else
    resume=1
    [ -n "$session" ] || die "$task: line $l_session: empty Implementer Session ID (write 'unassigned' for none)"
    # Anything but a UUID is not handed over: 'claude --resume <text>' opens a picker searching
    # for it, and a leading '-' would be read as an option.
    [[ "$session" =~ $UUID_RE ]] ||
        die "$task: line $l_session: Implementer Session ID '$session' is not a session UUID"
    agent=${agent_opt:-$harness_agent}
    [ -n "$agent" ] ||
        die "$task: line $l_session: session $session, but no program to resume it with: add" \
            "'**Harness: claude-code**', '**Harness: codex**' or '**Harness: cursor**' to the header," \
            "or pass --agent claude|codex|cursor"
    if [ "$agent" = "omp" ]; then
        die "$task: line $l_session: git dispatch cannot resume an omp session; resume it in omp" \
            "itself, or set Implementer Session ID to unassigned to start a new omp session"
    fi
fi
# cursor's command-line program is 'agent'. The others are named by --agent.
case "$agent" in
    cursor) agent_bin=agent ;;
    *) agent_bin=$agent ;;
esac
command -v "$agent_bin" > /dev/null 2>&1 || die "'$agent_bin' is not on PATH"

# Checked against the agent that will run, not against a union: 'claude --effort ultra' is not a
# level claude has, and a typo must not reach any agent to be rejected -- or quietly ignored.
# omp and cursor take no level at all. cursor's effort is a parameter of a model name, and the
# model is not chosen here, so there is no flag to pass. Nothing is passed, and only an explicit
# --effort is refused.
if [ "$agent" = "omp" ] || [ "$agent" = "cursor" ]; then
    [ "$seen_effort" -eq 0 ] ||
        die "--effort '$effort' is not a level $agent takes ($agent takes none)"
else
    if [ "$agent" = "claude" ]; then efforts=("${CLAUDE_EFFORTS[@]}"); else efforts=("${CODEX_EFFORTS[@]}"); fi
    known=0
    for e in "${efforts[@]}"; do [ "$e" = "$effort" ] && known=1; done
    [ "$known" -eq 1 ] ||
        die "--effort '$effort' is not a level $agent takes (${efforts[*]})"
fi

if [ -n "$cwd_opt" ]; then
    [ -d "$cwd_opt" ] || die "--cwd: no such directory: $cwd_opt"
    agent_cwd=$(cd -- "$cwd_opt" && pwd -P) || die "--cwd: cannot enter $cwd_opt"
else
    agent_cwd=$root
fi

# The task file as the agent will see it from where it starts: relative when it is below that
# directory (<repo>/context/TASK_<name>.md from the project root), absolute otherwise. A
# dispatch.root that is not a parent of the main checkout, or a --cwd that is not, names the
# file absolutely; the task file itself stays in the main checkout's context/. With
# dispatch.moveTask the file the agent is given is the one in its checkout
# (<repo>@<slug>/context/TASK_<name>.md from the root), whether it moves now or moved before.
task_in_main="$main/context/$task_base"
task_given=$task_in_main
if [ "$move_task" -eq 1 ]; then
    task_dest="$root/$repo@$slug/context/$task_base"
    task_given=$task_dest
fi
case "$task_given" in
    "$agent_cwd"/*) task_ref=${task_given#"$agent_cwd"/} ;;
    *) task_ref=$task_given ;;
esac

# A worker's report means it already worked this task: a Blocked task CO answered and set back to
# Pending, or a Returned one. It is a heading at column 0 after the header -- '## Report' or
# '## Report <n>', exactly -- and not one inside a fenced code block, where a spec quotes the
# headings it asks for. A fence closes on a run of its own character at least as long; one never
# closed runs to the end of the file, as in Markdown, and that is said rather than passed over.
report_line="" fence="" fence_line=""
if [ "$resume" -eq 1 ]; then
    lineno=0
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        line=${line%$'\r'}
        [ "$lineno" -le "${last%%:*}" ] && continue
        if [ -n "$fence" ]; then
            if [[ "$line" =~ $FENCE_CLOSE_RE ]] && [ "${BASH_REMATCH[1]:0:1}" = "${fence:0:1}" ] &&
                [ "${#BASH_REMATCH[1]}" -ge "${#fence}" ]; then
                fence=""
            fi
            continue
        fi
        if [[ "$line" =~ $FENCE_RE ]]; then
            fence=${BASH_REMATCH[1]} fence_line=$lineno
            continue
        fi
        if [[ "$line" =~ $REPORT_RE ]]; then
            report_line=$lineno
            break
        fi
    done < "$task"
    if [ -z "$report_line" ] && [ -n "$fence" ]; then
        echo "$SELF: note: the code block opened at line $fence_line is never closed; nothing after it" \
            "was read as a report" >&2
    fi
fi

# Codex has no effort flag; its -c takes a TOML value, so the level goes in as a quoted string.
codex_effort=(-c "model_reasoning_effort=\"$effort\"")

if [ "$resume" -eq 1 ]; then
    if [ -n "$report_line" ]; then
        message="Continue task: $task_ref - read it from the end."
    else
        message="Follow-up task: $task_ref"
    fi
    if [ "$agent" = "claude" ]; then
        argv=(claude --effort "$effort" --resume "$session" "$message")
    elif [ "$agent" = "cursor" ]; then
        # --resume takes the chat id; the message is the prompt. The workspace is the current
        # directory, which is where this exec starts, so no --workspace is passed.
        argv=("$agent_bin" --resume "$session" "$message")
    else
        # Codex asks which directory to use when a session's saved one differs from the current
        # one. -C names the directory chosen here, and outranks a saved tui.resume_cwd answer.
        argv=(codex resume "${codex_effort[@]}" -C "$agent_cwd" "$session" "$message")
    fi
else
    message="Task: $task_ref"
    if [ "$agent" = "claude" ]; then
        argv=(claude --effort "$effort" "$message")
    elif [ "$agent" = "omp" ] || [ "$agent" = "cursor" ]; then
        argv=("$agent_bin" "$message")
    else
        argv=(codex "${codex_effort[@]}" "$message")
    fi
fi

# --- the checkout ---------------------------------------------------------------------------

wt="$root/$repo@$slug"
branch="task/$slug"

# The worktree git knows at $wt, and where $branch is checked out, from the same listing.
wt_known=0 wt_branch="" wt_prunable=0 branch_at=""
cur_path="" cur_branch="" cur_prunable=0
while IFS= read -r line; do
    case "$line" in
        "worktree "*) cur_path=${line#worktree } ;;
        "branch "*) cur_branch=${line#branch } ;;
        prunable|"prunable "*) cur_prunable=1 ;;
        "")
            if [ "$cur_path" = "$wt" ]; then
                wt_known=1 wt_branch=$cur_branch wt_prunable=$cur_prunable
            fi
            [ "$cur_branch" = "refs/heads/$branch" ] && branch_at=$cur_path
            cur_path="" cur_branch="" cur_prunable=0
            ;;
    esac
done < <(printf '%s\n\n' "$listing")

branch_exists=0
git -C "$main" show-ref --verify --quiet "refs/heads/$branch" && branch_exists=1

if [ "$wt_known" -eq 1 ]; then
    [ "$wt_prunable" -eq 0 ] && [ -d "$wt" ] ||
        die "worktree $wt is registered but missing on disk; restore it or 'git worktree prune' it"
    if [ "$wt_branch" != "refs/heads/$branch" ]; then
        on=${wt_branch#refs/heads/}
        die "worktree $wt is on ${on:-a detached HEAD}, not $branch"
    fi
    create=0
else
    [ ! -e "$wt" ] && [ ! -L "$wt" ] ||
        die "$wt exists but is not a worktree of $main"
    [ -z "$branch_at" ] ||
        die "branch $branch is checked out at $branch_at, not at $wt"
    [ "$branch_exists" -eq 0 ] ||
        die "branch $branch exists but its worktree $wt does not; refusing to guess what it holds"
    create=1

    if base=$(git -C "$main" config --get dispatch.defaultBranch); then
        base_from="git config dispatch.defaultBranch"
    elif origin_head=$(git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD); then
        base=${origin_head#origin/}
        base_from="origin/HEAD"
    else
        candidates=()
        for b in main master; do
            git -C "$main" show-ref --verify --quiet "refs/heads/$b" && candidates+=("$b")
        done
        [ "${#candidates[@]}" -eq 1 ] ||
            die "cannot tell $repo's default branch: no origin/HEAD, and" \
                "${candidates[*]:-neither main nor master exists}${candidates[*]:+ both exist};" \
                "set it with 'git -C $main config dispatch.defaultBranch <branch>'"
        base=${candidates[0]}
        base_from="the only one of main/master"
    fi
    git -C "$main" show-ref --verify --quiet "refs/heads/$base" ||
        die "the default branch '$base' (from $base_from) has no local branch in $main"
    add=(git -C "$main" worktree add "$wt" -b "$branch" "$base")
fi

# --- the task file's move -------------------------------------------------------------------

# Relative path from directory $1 to path $2, both absolute and physical.
relpath() {
    local base=$1 target=$2 up=""
    while [ "$base" != "/" ] && [ "${target#"$base"/}" = "$target" ]; do
        base=$(dirname -- "$base")
        up+="../"
    done
    if [ "$base" = "/" ]; then
        printf '%s\n' "$up${target#/}"
    else
        printf '%s\n' "$up${target#"$base"/}"
    fi
}

# A link in the main checkout is a task moved before: it must lead to the copy in the checkout
# the Checkout line names, and that copy must be a file of its own. A regular file is moved now,
# into a context/ that is the checkout's own directory, onto a path that holds nothing. A file in
# both places is the channel split in two -- a writer that replaces files (sed -i) turned the link
# into a copy -- and which half is current is not this tool's to guess.
move=0 link_target=""
if [ "$move_task" -eq 1 ]; then
    if [ -L "$task_main" ]; then
        [ -f "$task_dest" ] && [ ! -L "$task_dest" ] && [ "$task_main" -ef "$task_dest" ] ||
            die "$task: a link to '$(readlink -- "$task_main")', not to the task's file in the checkout" \
                "that line $l_checkout names ($task_dest); point it there, or restore the file"
    elif [ -L "$wt/context" ] || { [ -e "$wt/context" ] && [ ! -d "$wt/context" ]; }; then
        die "$task: cannot move the task file into $wt/context: not a directory of the checkout's own"
    elif [ -f "$task_dest" ] && [ ! -L "$task_dest" ]; then
        die "$task: a regular file, and the checkout holds one too ($task_dest): the link was replaced" \
            "with a copy, and the task now has two files. Keep the current one at $task_dest and put" \
            "the link back ('ln -sf $(relpath "$main_ctx" "$task_dest") $task_main')"
    elif [ -e "$task_dest" ] || [ -L "$task_dest" ]; then
        die "$task: cannot move the task file to $task_dest: that path already exists"
    else
        move=1
        link_target=$(relpath "$main_ctx" "$task_dest")
    fi
fi

# --- act ------------------------------------------------------------------------------------

quote() {
    local out="" a
    for a in "$@"; do out+="${out:+ }$(printf '%q' "$a")"; done
    printf '%s\n' "$out"
}

if [ "$resume" -eq 0 ]; then
    how="new session"
elif [ -n "$report_line" ]; then
    how="resume $session with $agent, continuing: a report at line $report_line"
else
    how="resume $session with $agent, a follow-up: no report"
fi
echo "$SELF: task $task_abs ($status, $how)"
if [ "$dry_run" -eq 1 ]; then
    echo "$SELF: root: $root    ($root_from)"
fi
if [ "$create" -eq 1 ]; then
    echo "$SELF: worktree: $(quote "${add[@]}")    (from $base, via $base_from)"
else
    echo "$SELF: worktree: reuse $wt ($branch) as it is"
fi
if [ "$move" -eq 1 ]; then
    echo "$SELF: move: $task_main -> $task_dest"
    echo "$SELF: link: $task_main -> $link_target"
elif [ "$move_task" -eq 1 ]; then
    echo "$SELF: task file: $task_main links to $task_dest; nothing moves"
fi
echo "$SELF: cwd: $agent_cwd"
echo "$SELF: exec: $(quote "${argv[@]}")"

if [ "$dry_run" -eq 1 ]; then
    echo "$SELF: dry run -- nothing changed"
    exit 0
fi

if [ "$create" -eq 1 ]; then
    "${add[@]}" || die "git worktree add failed; the agent was not started"
fi
# The link is made first, under a temporary name beside the task file, so that the one step that
# can fail for want of a link fails before anything moves. Then the file is renamed into the
# checkout, and the link renamed over the path it left. At every moment one of the two paths
# holds the file: the main path until the first rename, the checkout's path from then on. Between
# the two renames the main path is briefly empty. Should the second rename fail, the file is moved
# back; should that fail too, where everything is left is said.
if [ "$move" -eq 1 ]; then
    tmp_link="$main_ctx/.$task_base.dispatch-link.$$"
    mkdir -p -- "$wt/context" ||
        die "cannot create $wt/context; the task file did not move, and the agent was not started"
    ln -s -- "$link_target" "$tmp_link" ||
        die "cannot create a link in $main_ctx; the task file did not move, and the agent was not started"
    if ! mv -- "$task_main" "$task_dest"; then
        rm -f -- "$tmp_link"
        die "cannot move $task_main to $task_dest; it is still where it was, and the agent was not started"
    fi
    if ! mv -- "$tmp_link" "$task_main"; then
        if mv -- "$task_dest" "$task_main"; then
            rm -f -- "$tmp_link"
            die "cannot put the link at $task_main; the task file was moved back there, and the agent" \
                "was not started"
        fi
        die "cannot put the link at $task_main, nor move the task file back: it is at $task_dest, and" \
            "the link is at $tmp_link. Rename the link ('mv $tmp_link $task_main'); the agent was not started"
    fi
fi
cd -- "$agent_cwd" || die "cannot enter $agent_cwd"
exec "${argv[@]}"
